#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION STLQV_VERSION_COMMA
PRODUCTVERSION STLQV_VERSION_COMMA
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "STL Quick View Explorer Preview"
            VALUE "FileVersion", STLQV_VERSION_STR
            VALUE "OriginalFilename", "StlQuickViewShell.dll"
            VALUE "ProductName", "STL Quick View"
            VALUE "ProductVersion", STLQV_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
