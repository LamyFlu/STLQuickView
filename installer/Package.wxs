<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <!-- Version comes from the VERSION file via build-msi.ps1 (-d Version=x.y.z).
         ProductCode is generated per build, so every MSI is a major upgrade of the last one. -->
    <Package Name="STL Quick View" Manufacturer="STL Quick View" Version="$(Version)"
             UpgradeCode="{01BC6F1E-C6C7-480A-BBFF-B5C10C17F20E}"
             Scope="perUser" Language="1028" Codepage="65001">
        <!-- Installing over an older or the same version replaces it in place; downgrades are refused. -->
        <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallInitialize"
                      DowngradeErrorMessage="此電腦已安裝較新版的 STL Quick View。若要改裝這個版本，請先在 Windows 設定移除目前的版本。" />
        <WixVariable Id="WixUIBannerBmp" Value="installer\banner.bmp" />
        <WixVariable Id="WixUIDialogBmp" Value="installer\dialog.bmp" />
        <Property Id="QV_ACTION" Value="安裝" />
        <SetProperty Id="QV_ACTION" Value="更新" After="FindRelatedProducts" Sequence="ui"
                     Condition="WIX_UPGRADE_DETECTED" />
        <Property Id="ARPCOMMENTS" Value="快速檢視 STL 3D 模型，並提供檔案總管預覽。" />
        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
        <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        <Icon Id="ProductIcon" SourceFile="StlQuickView.ico" />
        <Property Id="ARPNOMODIFY" Value="1" />
        <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />

        <?define ProgId = StlQuickView.Model ?>
        <?define MeshProgId = StlQuickView.Mesh ?>
        <?define Preview = {8FA42D75-2473-4D80-93BA-D73BE4A577C2} ?>
        <?define PreviewType = {8895B1C6-B41F-4C1C-A562-0D564250836F} ?>
        <?define PreviewHost = {6D2B5079-2F0B-48DD-AB7F-97CEC514D30B} ?>
        <?define PreviewBinding = Software\Classes\SystemFileAssociations\.stl\ShellEx\$(PreviewType) ?>
        <?define PreviewServer = Software\Classes\CLSID\$(Preview)\InprocServer32 ?>
        <?define ShellDllName = StlQuickViewShell.dll ?>
        <?define Capabilities = Software\StlQuickView\Capabilities ?>
        <?define Thumbnail = {7746619E-43C9-4FD6-8AAC-787E3F398AB1} ?>
        <?define ThumbnailType = {E357FCCD-A995-4576-B01F-234630154E96} ?>
        <?define ThumbnailServer = Software\Classes\CLSID\$(Thumbnail)\InprocServer32 ?>
        <?define PlateThumbnail = {C3930DB2-AD88-4E7F-920B-47544E805C39} ?>
        <?define PlateThumbnailServer = Software\Classes\CLSID\$(PlateThumbnail)\InprocServer32 ?>
        <?define PlateThumbnailBinding = Software\Classes\.3mf\ShellEx\$(ThumbnailType) ?>

        <Property Id="EXISTING_PREVIEW_SERVER">
            <RegistrySearch Id="ExistingPreviewServer" Root="HKCU" Key="$(PreviewServer)"
                            Type="raw" Bitness="always64" />
        </Property>
        <Property Id="EXISTING_USER_STL_PREVIEW">
            <RegistrySearch Id="ExistingUserStlPreview" Root="HKCU" Key="$(PreviewBinding)"
                            Type="raw" Bitness="always64" />
        </Property>
        <Property Id="EXISTING_MACHINE_STL_PREVIEW">
            <RegistrySearch Id="ExistingMachineStlPreview" Root="HKLM" Key="$(PreviewBinding)"
                            Type="raw" Bitness="always64" />
        </Property>
        <Property Id="EXISTING_USER_3MF_THUMBNAIL">
            <RegistrySearch Id="ExistingUser3mfThumbnail" Root="HKCU" Key="$(PlateThumbnailBinding)"
                            Type="raw" Bitness="always64" />
        </Property>
        <Launch Condition='Installed OR WIX_UPGRADE_DETECTED OR NOT EXISTING_PREVIEW_SERVER'
                Message="請先以原先的 Setup.ps1 加上 -Uninstall 移除舊版檔案總管整合，再執行 MSI。" />
        <Launch Condition='Installed OR WIX_UPGRADE_DETECTED OR (NOT EXISTING_USER_STL_PREVIEW AND NOT EXISTING_MACHINE_STL_PREVIEW)'
                Message="已有其他 STL 檔案總管預覽擴充。請先停用原有擴充，再安裝 STL Quick View。" />

        <StandardDirectory Id="LocalAppDataFolder">
                <Directory Id="INSTALLFOLDER" Name="STL Quick View">
                    <Component Id="Viewer" Guid="{228ACB03-58BE-4CAE-AB58-2DF2BF31AF58}">
                        <File Id="ViewerExe" Source="dist\StlQuickView.exe" />
                        <Shortcut Id="ViewerShortcut" Directory="ProgramMenuFolder" Name="STL Quick View"
                                  Description="快速檢視 STL 3D 模型" Target="[#ViewerExe]" WorkingDirectory="INSTALLFOLDER" />
                        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
                        <RegistryValue Root="HKCU" Key="Software\StlQuickView\Installer"
                                       Name="Engine" Value="MSI" Type="string" KeyPath="yes" />
                        <RegistryKey Root="HKCU" Key="Software\Classes\$(ProgId)">
                            <RegistryValue Value="STL 3D 模型" Type="string" />
                            <RegistryValue Key="DefaultIcon" Value="&quot;[#ViewerExe]&quot;,0" Type="string" />
                            <RegistryValue Key="shell\open\command" Value="&quot;[#ViewerExe]&quot; &quot;%1&quot;" Type="string" />
                            <RegistryValue Key="ShellEx\$(PreviewType)" Value="$(Preview)" Type="string" />
                            <RegistryValue Key="ShellEx\$(ThumbnailType)" Value="$(Thumbnail)" Type="string" />
                            <!-- Thumbnails: no photo frame and no app-icon overlay, so the transparent model stands alone. -->
                            <RegistryValue Name="Treatment" Value="0" Type="integer" />
                            <RegistryValue Name="TypeOverlay" Value="" Type="string" />
                        </RegistryKey>
                        <!-- Prefer the high-performance GPU on hybrid-graphics PCs (Settings > Display > Graphics). -->
                        <RegistryValue Root="HKCU" Key="Software\Microsoft\DirectX\UserGpuPreferences"
                                       Name="[#ViewerExe]" Value="GpuPreference=2;" Type="string" />
                        <RegistryValue Root="HKCU" Key="Software\Classes\.stl\OpenWithProgids"
                                       Name="$(ProgId)" Type="string" Value="" />
                        <!-- 3MF, OBJ and PLY share the viewer association. The 3MF thumbnail is registered separately. -->
                        <RegistryKey Root="HKCU" Key="Software\Classes\$(MeshProgId)">
                            <RegistryValue Value="3D 模型" Type="string" />
                            <RegistryValue Key="DefaultIcon" Value="&quot;[#ViewerExe]&quot;,0" Type="string" />
                            <RegistryValue Key="shell\open\command" Value="&quot;[#ViewerExe]&quot; &quot;%1&quot;" Type="string" />
                        </RegistryKey>
                        <RegistryValue Root="HKCU" Key="Software\Classes\.3mf\OpenWithProgids"
                                       Name="$(MeshProgId)" Type="string" Value="" />
                        <RegistryValue Root="HKCU" Key="Software\Classes\.obj\OpenWithProgids"
                                       Name="$(MeshProgId)" Type="string" Value="" />
                        <RegistryValue Root="HKCU" Key="Software\Classes\.ply\OpenWithProgids"
                                       Name="$(MeshProgId)" Type="string" Value="" />
                        <RegistryKey Root="HKCU" Key="$(Capabilities)">
                            <RegistryValue Name="ApplicationName" Value="STL Quick View" Type="string" />
                            <RegistryValue Name="ApplicationDescription" Value="快速檢視 STL、3MF、OBJ、PLY 3D 模型。" Type="string" />
                            <RegistryValue Key="FileAssociations" Name=".stl" Value="$(ProgId)" Type="string" />
                            <RegistryValue Key="FileAssociations" Name=".3mf" Value="$(MeshProgId)" Type="string" />
                            <RegistryValue Key="FileAssociations" Name=".obj" Value="$(MeshProgId)" Type="string" />
                            <RegistryValue Key="FileAssociations" Name=".ply" Value="$(MeshProgId)" Type="string" />
                        </RegistryKey>
                        <RegistryValue Root="HKCU" Key="Software\RegisteredApplications"
                                       Name="STL Quick View" Value="$(Capabilities)" Type="string" />
                    </Component>
                    <Component Id="LicenseDocuments" Guid="{43E4BB60-CE36-4448-8502-64F5917DB191}">
                        <File Id="ProjectLicense" Name="LICENSE.txt" Source="LICENSE" />
                        <File Id="ThirdPartyNotices" Source="THIRD_PARTY_NOTICES.md" />
                        <RegistryValue Root="HKCU" Key="Software\StlQuickView\Installer"
                                       Name="LicenseDocuments" Value="1" Type="integer" KeyPath="yes" />
                    </Component>
                    <Component Id="ExplorerPreview" Guid="{9B8FF978-62B3-464E-AA3A-A83CF4B802E7}">
                        <File Id="ShellDll" Source="dist\$(ShellDllName)" />
                        <RegistryValue Root="HKCU" Key="$(PreviewServer)" Value="[#ShellDll]" Type="string" KeyPath="yes" />
                        <RegistryValue Root="HKCU" Key="$(PreviewServer)" Name="ThreadingModel" Value="Apartment" Type="string" />
                        <RegistryKey Root="HKCU" Key="Software\Classes\CLSID\$(Preview)">
                            <RegistryValue Value="STL Quick View Preview" Type="string" />
                            <RegistryValue Name="AppID" Value="$(PreviewHost)" Type="string" />
                        </RegistryKey>
                        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\PreviewHandlers"
                                       Name="$(Preview)" Value="STL Quick View Preview" Type="string" />
                        <RegistryValue Root="HKCU" Key="$(PreviewBinding)" Value="$(Preview)" Type="string" />
                    </Component>
                    <Component Id="ExplorerThumbnail" Guid="{3E0C2B57-8D51-4E7A-9C1B-6F2A4D8E7B31}">
                        <RegistryValue Root="HKCU" Key="$(ThumbnailServer)" Value="[INSTALLFOLDER]$(ShellDllName)" Type="string" KeyPath="yes" />
                        <RegistryValue Root="HKCU" Key="$(ThumbnailServer)" Name="ThreadingModel" Value="Apartment" Type="string" />
                        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\$(Thumbnail)" Value="STL Quick View Thumbnail" Type="string" />
                        <RegistryKey Root="HKCU" Key="Software\Classes\SystemFileAssociations\.stl">
                            <RegistryValue Key="ShellEx\$(ThumbnailType)" Value="$(Thumbnail)" Type="string" />
                            <RegistryValue Name="Treatment" Value="0" Type="integer" />
                            <RegistryValue Name="TypeOverlay" Value="" Type="string" />
                        </RegistryKey>
                    </Component>
                    <Component Id="ExplorerPlateThumbnail" Guid="{E268F88B-CA31-47B9-9AC4-12E9487840F7}"
                               Condition='NOT EXISTING_USER_3MF_THUMBNAIL OR EXISTING_USER_3MF_THUMBNAIL ~= "$(PlateThumbnail)"'>
                        <RegistryValue Root="HKCU" Key="$(PlateThumbnailServer)" Value="[INSTALLFOLDER]$(ShellDllName)" Type="string" KeyPath="yes" />
                        <RegistryValue Root="HKCU" Key="$(PlateThumbnailServer)" Name="ThreadingModel" Value="Apartment" Type="string" />
                        <RegistryValue Root="HKCU" Key="Software\Classes\CLSID\$(PlateThumbnail)" Value="STL Quick View 3MF Plate Thumbnail" Type="string" />
                        <RegistryValue Root="HKCU" Key="$(PlateThumbnailBinding)" Value="$(PlateThumbnail)" Type="string" />
                    </Component>
                </Directory>
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder" />

        <Feature Id="Complete" Title="STL Quick View" Level="1">
            <ComponentRef Id="Viewer" />
            <ComponentRef Id="LicenseDocuments" />
            <ComponentRef Id="ExplorerPreview" />
            <ComponentRef Id="ExplorerThumbnail" />
            <ComponentRef Id="ExplorerPlateThumbnail" />
        </Feature>

        <Binary Id="InstallerActions" SourceFile="build\StlQuickViewInstallerActions.dll" />
        <CustomAction Id="NotifyExplorer" BinaryRef="InstallerActions" DllEntry="NotifyExplorer" Return="ignore" />
        <CustomAction Id="OpenDefaultApps" BinaryRef="InstallerActions" DllEntry="OpenDefaultApps" Return="ignore" />
        <InstallExecuteSequence>
            <Custom Action="NotifyExplorer" After="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
        </InstallExecuteSequence>

        <UIRef Id="WixUI_Common" />
        <UI>
            <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft JhengHei UI" Size="9" />
            <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft JhengHei UI" Size="12" />
            <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft JhengHei UI" Size="9" Bold="yes" />
            <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
            <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="已啟用檔案總管的 STL 預覽。按 Alt+P 可開啟預覽窗格。" />
            <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="開啟 Windows 設定，以套用 STL 圖示與預設開啟程式" />
            <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
            <DialogRef Id="ErrorDlg" />
            <DialogRef Id="FatalError" />
            <DialogRef Id="FilesInUse" />
            <DialogRef Id="MsiRMFilesInUse" />
            <DialogRef Id="ProgressDlg" />
            <DialogRef Id="UserExit" />
            <DialogRef Id="MaintenanceWelcomeDlg" />
            <DialogRef Id="MaintenanceTypeDlg" />
            <DialogRef Id="VerifyReadyDlg" />
            <DialogRef Id="ExitDialog" />

            <Dialog Id="QuickViewWelcome" Width="370" Height="270" Title="[ProductName] 安裝程式">
                <Control Id="Bitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="234" TabSkip="no"
                         Text="WixUI_Bmp_Dialog" />
                <Control Id="Heading" Type="Text" X="135" Y="22" Width="220" Height="20" Transparent="yes"
                         NoPrefix="yes" Text="{\WixUI_Font_Bigger}[QV_ACTION] STL Quick View" />
                <Control Id="Version" Type="Text" X="135" Y="46" Width="220" Height="14" Transparent="yes"
                         NoPrefix="yes" Text="版本 [ProductVersion]" />
                <Control Id="Description" Type="Text" X="135" Y="74" Width="220" Height="40" Transparent="yes"
                         NoPrefix="yes" Text="安裝會加入 STL 檢視器、檔案總管預覽與模型縮圖，只套用到目前的使用者。" />
                <Control Id="DefaultAppsDescription" Type="Text" X="135" Y="118" Width="220" Height="40"
                         Transparent="yes" NoPrefix="yes"
                         Text="安裝完成後，可在 Windows 設定選用專用圖示及雙擊開啟方式。" />
                <Control Id="UpgradeDescription" Type="Text" X="135" Y="166" Width="220" Height="40"
                         Transparent="yes" NoPrefix="yes" Hidden="yes" ShowCondition="WIX_UPGRADE_DETECTED"
                         Text="已偵測到先前安裝的版本，會直接覆蓋更新，並保留您的顏色設定。" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Install" Type="PushButton" X="226" Y="243" Width="60" Height="18"
                         Default="yes" Text="[QV_ACTION]">
                    <Publish Event="EndDialog" Value="Return" />
                </Control>
                <Control Id="Cancel" Type="PushButton" X="296" Y="243" Width="54" Height="18"
                         Cancel="yes" Text="取消">
                    <Publish Event="EndDialog" Value="Exit" />
                </Control>
            </Dialog>

            <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
            <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
            <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
            <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" />
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenDefaultApps" Order="1"
                     Condition='NOT Installed AND WIXUI_EXITDIALOGOPTIONALCHECKBOX = "1"' />
            <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="2" />
            <InstallUISequence>
                <Show Dialog="QuickViewWelcome" Before="ProgressDlg" Condition="NOT Installed" />
                <Custom Action="NotifyExplorer" After="ExecuteAction" Condition="NOT UPGRADINGPRODUCTCODE" />
            </InstallUISequence>
        </UI>
    </Package>
</Wix>
